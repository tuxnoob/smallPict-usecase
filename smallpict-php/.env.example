SERVER_PORT=8005
APP_NAME="SmallPict PHP Service"

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smallpict
DB_USER=postgres
DB_PASS=postgres
DB_SSLMODE=disable

# SmallPict
# mode: locale | cdn
SMALLPICT_MODE=locale
SMALLPICT_BASE_URL=https://api.smallpict.app
SMALLPICT_API_KEY=
SMALLPICT_SECRET_KEY=
# format: auto | webp | avif | jpeg | png
SMALLPICT_FORMAT=auto
SMALLPICT_QUALITY=80

UPLOAD_PATH=./uploads

